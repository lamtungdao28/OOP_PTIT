# Local development: Spring Boot loads .env, then .env.local from the backend directory.
# Put new application secrets in the ignored .env.local, not the already-tracked .env.
# Use plain KEY=value lines without shell quotes or export; .env.example is not loaded.
# Environment variables from the shell, IDE or secret manager take precedence over both files.
# Reuse the existing Docker credentials; changing these does not reset a populated volume.
MYSQL_DATABASE=your_existing_database
MYSQL_ROOT_PASSWORD=
# The supplied compose.yaml publishes MySQL on host port 3307.
# For deployment, override all DB_* values with a dedicated, least-privileged DB account.
DB_URL=jdbc:mysql://localhost:3307/${MYSQL_DATABASE}
DB_USERNAME=root
DB_PASSWORD=${MYSQL_ROOT_PASSWORD}
# Generate once per environment with: openssl rand -base64 32
JWT_SECRET=
JWT_ISSUER=oop-ptit
JWT_AUDIENCE=oop-ptit-api
JWT_TTL=15m
CORS_ALLOWED_ORIGINS=http://localhost:5173
API_DOCS_ENABLED=false
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
